    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.8.1",
    "sass": "^1.72.0",
